# Sanitized example from a real SLURM cluster (ABACUS + VASP + QE).
# Copy to install/config.env and adjust the <...> placeholders.
#
#   cp install/config.env.yeesuan.example install/config.env

PROFILE_NAME="aiida_profile"
COMPUTER_LABEL="yeesuan"
CODE_ABACUS_LABEL="abacus_lts"
CODE_VASP_LABEL="vaspstd"

AIIDA_EMAIL="you@example.com"
AIIDA_FIRST_NAME="First"
AIIDA_LAST_NAME="Last"
AIIDA_INSTITUTION="Your Institute"

PROFILE_BACKEND="psql"
PROFILE_FILEPATH="$HOME/data/aiida_profile/profile"
DB_USERNAME="aiida_user"
DB_PASSWORD="change-me"
DB_NAME="aiida_db"
DB_HOST="127.0.0.1"
DB_PORT="5432"
REPOSITORY_URI="file://$HOME/data/aiida_profile/repository"

# ssh alias for the login node (put Host/User/ProxyJump in ~/.ssh/config)
COMPUTER_HOST="10.100.69.5"
COMPUTER_WORKDIR="/sh3/<project>/home/<user>/aiida_data/work"
COMPUTER_MPIPROCS_PER_MACHINE="56"
COMPUTER_MEMORY_KB="50000000"
COMPUTER_MPIRUN="mpirun -np {tot_num_mpiprocs}"
# this cluster has two queues: a 2 h queue and a 24 h/1.5 TB queue
COMPUTER_QUEUE="q_ysuan"

# ABACUS 3.10 built with spack: the environment must be loaded in every job.
ABACUS_EXECUTABLE="/sh3/<project>/home/<user>/software/abacus_3.10.0/bin/abacus"
ABACUS_PREPEND='
. /sh3/<project>/share/spack/share/spack/setup-env.sh
spack load gcc@12.1.0
spack load elpa@2021.11.001%intel@2021.4.0
spack load libxc@6.0.0
'
VASP_EXECUTABLE="/sh3/<project>/home/<user>/software/vasp.6.4.2/bin/vasp_std"
VASP_PREPEND='
. /sh3/<project>/share/spack/share/spack/setup-env.sh
spack load intel-oneapi-mkl@2021.4.0
spack load intel-oneapi-mpi@2021.4.0
spack load intel-oneapi-compilers@2021.4.0
'

SSSP_VERSION="1.3"
SSSP_FUNCTIONAL="PBE"
SSSP_PRECISION="precision"

# ABACUS needs its own UPF + numerical-orbital families (AtomicOrbitalFamily),
# which `aiida-pseudo` does not manage; see install/05-pseudo.sh and
# troubleshooting/cases/005-abacus-pseudo-family-naming.yaml.
