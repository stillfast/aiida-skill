# Copy to install/config.env and fill in. Sourced by 02-profile.sh .. 05-pseudo.sh.
#
#   cp install/config.env.example install/config.env

# ---- names ---------------------------------------------------------------
PROFILE_NAME="aiida_profile"
COMPUTER_LABEL="mycluster"
CODE_ABACUS_LABEL="abacus"
CODE_VASP_LABEL="vaspstd"

# ---- identity (verdi profile setup) --------------------------------------
AIIDA_EMAIL="you@example.com"
AIIDA_FIRST_NAME="First"
AIIDA_LAST_NAME="Last"
AIIDA_INSTITUTION="Your Institute"

# ---- profile backend -----------------------------------------------------
# sqlite (zero dependency, single user) or psql (production)
PROFILE_BACKEND="sqlite"
# sqlite only:
PROFILE_FILEPATH="$HOME/data/aiida_profile/profile"
# psql only:
DB_USERNAME="aiida_user"
DB_PASSWORD="change-me"
DB_NAME="aiida_db"
DB_HOST="127.0.0.1"
DB_PORT="5432"
REPOSITORY_URI="file://$HOME/data/aiida_profile/repository"

# ---- computer (SLURM over ssh) ------------------------------------------
COMPUTER_HOST="10.0.0.1"
COMPUTER_WORKDIR="/path/on/cluster/aiida_work"
COMPUTER_MPIPROCS_PER_MACHINE="56"
COMPUTER_MEMORY_KB="50000000"
COMPUTER_MPIRUN="mpirun -np {tot_num_mpiprocs}"
COMPUTER_QUEUE="default"

# ---- codes ---------------------------------------------------------------
ABACUS_EXECUTABLE="/path/on/cluster/bin/abacus"
ABACUS_PREPEND='
module purge
module load gcc/12.1.0
'
VASP_EXECUTABLE="/path/on/cluster/bin/vasp_std"
VASP_PREPEND='
module purge
module load intel-oneapi-mkl intel-oneapi-mpi
'

# ---- pseudopotentials ----------------------------------------------------
# SSSP: version/library/functional/precision used by aiida-pseudo
SSSP_VERSION="1.3"
SSSP_FUNCTIONAL="PBE"
SSSP_PRECISION="precision"
